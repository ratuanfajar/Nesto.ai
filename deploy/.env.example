# Salin jadi `.env` di folder deploy/ ini - docker compose membacanya otomatis.
#   copy .env.example .env      (PowerShell / cmd)
#
# Pakai berkas ini, jangan menaruh env var di depan perintah: `NESTO_API_KEY=x
# docker compose up` adalah sintaks bash dan TIDAK bekerja di PowerShell - di sana
# ia jadi error, bukan sekadar terabaikan.
#
# .env berisi rahasia, jadi jangan di-commit. `.gitignore` sudah menutupnya.

# Wajib diganti sebelum service dijangkau dari luar. Kosongkan hanya kalau
# service benar-benar tidak bisa diakses dari luar jaringan internal.
NESTO_API_KEY=ganti-dengan-nilai-acak-yang-panjang

# Origin frontend yang boleh memanggil API, dipisah koma.
NESTO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# false = bf16, ~5 GB VRAM, lebih cepat.
# true  = 4-bit, ~2.5 GB VRAM. Pilih ini di GPU 8 GB yang dipakai bersama
#         aplikasi lain (browser, kernel notebook) - bf16 akan OOM.
NESTO_LOAD_4BIT=false
