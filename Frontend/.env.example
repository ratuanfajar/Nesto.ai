# Copy file ini jadi .env, lalu isi sesuai environment kamu
# WIFI_ADDRESS = IP address laptop/komputer tempat Docker backend berjalan
# Cara dapatnya:
#   - Windows : ipconfig            -> lihat "IPv4 Address"
#   - macOS   : ipconfig getifaddr en0
#   - Linux   : hostname -I
# Kalau test pakai emulator (bukan HP fisik), biarkan default 10.0.2.2
WIFI_ADDRESS=10.0.2.2

# NESTO_API_KEY = isi SAMA PERSIS dengan NESTO_API_KEY di deploy/.env backend
# Kosongkan kalau backend tidak mewajibkan API key
NESTO_API_KEY=